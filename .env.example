# ---- App ----
NODE_ENV=development
PORT=3000
# Pisahkan dengan koma, atau * untuk mengizinkan semua origin
CORS_ORIGIN=*
# Default: aktif kecuali NODE_ENV=production
# SWAGGER_ENABLED=true
TZ=Asia/Jakarta

# ---- Database ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app
DB_USER=postgres
DB_PASSWORD=postgres
# Jangan aktifkan di production, gunakan migration
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ---- Auth ----
# Wajib minimal 32 karakter. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1h

# ---- Rate limit ----
# Jendela waktu (ms) dan jumlah request maksimal per IP
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
