{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "globalSetup": "<rootDir>/global-setup.ts",
  "setupFiles": [
    "<rootDir>/setup-e2e.ts"
  ],
  "transform": {
    "^.+\\.ts$": "ts-jest",
    "^.+\\.js$": [
      "ts-jest",
      {
        "tsconfig": {
          "allowJs": true
        }
      }
    ]
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(\\.pnpm/[^/]+/node_modules/)?@nestjs/drizzle/)"
  ]
}
